# Copy to .env and fill in. Never commit .env.

# --- Core ---
OKANE_ENV=dev                                # dev | prod
OKANE_ADDR=:8080
OKANE_APP_URL=http://localhost:5173          # web app origin (CORS + cookie)
OKANE_LOG_FORMAT=text                        # text | json

# --- Database ---
OKANE_DATABASE_URL=postgres://okane:okane@localhost:5432/okane?sslmode=disable

# --- Sessions ---
OKANE_SESSION_TTL=720h                       # 30 days
OKANE_SESSION_COOKIE_SECURE=false            # true when served over HTTPS

# --- Locale ---
OKANE_TIMEZONE=America/Mexico_City           # IANA timezone; month boundaries follow it

# --- Belvo (bank aggregation) ---
OKANE_BELVO_ENV=sandbox                      # sandbox | production
OKANE_BELVO_SECRET_ID=
OKANE_BELVO_SECRET_PASSWORD=

# --- AI (OpenCode Inference, OpenAI-compatible) ---
OKANE_AI_BASE_URL=https://opencode.ai/inference/openai/v1
OKANE_AI_API_KEY=
OKANE_AI_MODEL=glm-5.1
