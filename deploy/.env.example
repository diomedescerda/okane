# Copy to deploy/.env on the VPS. Never commit this file.

# Domain Caddy will serve and get a TLS certificate for (must point at the VPS).
OKANE_DOMAIN=okane.example.com

# Postgres password (generate one: openssl rand -base64 24).
POSTGRES_PASSWORD=

# Sessions
OKANE_SESSION_TTL=720h
OKANE_TIMEZONE=America/Bogota

# Belvo (sandbox or production keys from the Belvo dashboard).
OKANE_BELVO_ENV=sandbox
OKANE_BELVO_SECRET_ID=
OKANE_BELVO_SECRET_PASSWORD=

# AI inference (OpenCode Console service account key).
OKANE_AI_BASE_URL=https://opencode.ai/inference/openai/v1
OKANE_AI_API_KEY=
OKANE_AI_MODEL=glm-5.1
