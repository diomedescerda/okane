# Builds the Okane API binary. Build from the repository root:
#   docker build -f deploy/Dockerfile.api -t okane-api .
FROM golang:1.27-alpine AS build
WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" \
    -tags no_sqlite3,no_libsql,no_mysql,no_duckdb,no_vertica,no_clickhouse \
    -o /out/okane ./cmd/okane

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/okane /okane
EXPOSE 8080
ENTRYPOINT ["/okane"]
CMD ["serve"]
