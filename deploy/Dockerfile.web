# Builds the web SPA and serves it with Caddy (which also reverse-proxies
# /api to the api service). Build from the repository root:
#   docker build -f deploy/Dockerfile.web -t okane-web .
FROM node:24-alpine AS build
WORKDIR /web

COPY web/package.json web/package-lock.json ./
RUN npm ci

COPY web/ ./
RUN npm run build

FROM caddy:2-alpine
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /web/dist /srv/web
